{
  "name": "mcp-adr-analysis-server-docs",
  "version": "2.0.0",
  "description": "Documentation website for MCP ADR Analysis Server",
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "dev": "echo '🌐 Starting Docusaurus development server...' && docusaurus start",
    "docs:build": "echo '🔨 Building Docusaurus for production...' && docusaurus build && echo '✅ Build complete!'",
    "clean": "echo '🧹 Cleaning build artifacts...' && rm -rf build .docusaurus && echo '✅ Cleanup complete!'",
    "setup": "echo '🚀 Setting up Docusaurus documentation...' && npm install && echo '✅ Setup complete! Run npm run dev to start'"
  },
  "dependencies": {
    "@docusaurus/core": "^3.1.0",
    "@docusaurus/preset-classic": "^3.1.0",
    "@docusaurus/theme-mermaid": "^3.1.0",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^18.2.0",
    "react-dom": "^19.2.8",
    "@easyops-cn/docusaurus-search-local": "^0.55.3"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.1.0",
    "@docusaurus/tsconfig": "^3.10.2",
    "@docusaurus/types": "^3.1.0",
    "typescript": "~7.0.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=18.0"
  },
  "keywords": [
    "documentation",
    "docusaurus",
    "mcp",
    "architecture",
    "adr"
  ],
  "author": "Tosin Akinosho",
  "license": "MIT"
}
